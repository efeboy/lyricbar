<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Sandbox is OFF: sending Apple Events to arbitrary apps (Spotify, Music)
         is incompatible with the App Sandbox without discouraged temporary
         exceptions. This is a personal login-item utility, not an App Store app. -->
    <key>com.apple.security.app-sandbox</key>
    <false/>

    <!-- Under the Hardened Runtime (required for notarization) an app must
         declare this to send Apple Events at all. -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
